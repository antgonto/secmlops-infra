# Rendered by Ansible. Core SecMLOps platform services.
# All data persists under {{ data_root }} on the VM.
name: secmlops-core

services:
  # S3-compatible object store: VersityGW (Apache-2.0). Replaces MinIO, whose
  # upstream repo was archived in April 2026. POSIX backend: every top-level
  # directory under /data is a bucket.
  s3:
    image: ghcr.io/versity/versitygw:v1.8.0
    command: ["--port", ":7070", "posix", "/data"]
    environment:
      ROOT_ACCESS_KEY: "{{ s3_access_key }}"
      ROOT_SECRET_KEY: "{{ s3_secret_key }}"
    ports:
      - "7070:7070"
    volumes:
      - "{{ data_root }}/s3:/data"
    restart: unless-stopped

  openbao:
    image: quay.io/openbao/openbao:latest
    command: server -dev -dev-listen-address=0.0.0.0:8200
    environment:
      BAO_DEV_ROOT_TOKEN_ID: "{{ bao_root_token }}"
    cap_add:
      - IPC_LOCK
    ports:
      - "8200:8200"
    restart: unless-stopped

  mlflow-db:
    image: postgres:16
    environment:
      POSTGRES_USER: mlflow
      POSTGRES_PASSWORD: "mlflow"
      POSTGRES_DB: mlflow
    volumes:
      - "{{ data_root }}/mlflow-db:/var/lib/postgresql/data"
    restart: unless-stopped

  mlflow:
    image: ghcr.io/mlflow/mlflow:latest
    depends_on:
      - mlflow-db
      - s3
    command: >-
      bash -c "pip install psycopg2-binary boto3 &&
      mlflow server --host 0.0.0.0 --port 5000
      --backend-store-uri postgresql://mlflow:mlflow@mlflow-db/mlflow
      --artifacts-destination s3://mlflow"
    environment:
      MLFLOW_S3_ENDPOINT_URL: http://s3:7070
      AWS_ACCESS_KEY_ID: "{{ s3_access_key }}"
      AWS_SECRET_ACCESS_KEY: "{{ s3_secret_key }}"
    ports:
      - "5000:5000"
    restart: unless-stopped

  secobserve-db:
    image: postgres:16
    environment:
      POSTGRES_USER: secobserve
      POSTGRES_PASSWORD: "secobserve"
      POSTGRES_DB: secobserve
    volumes:
      - "{{ data_root }}/secobserve-db:/var/lib/postgresql/data"
    restart: unless-stopped

  secobserve:
    image: maibornwolff/secobserve-backend:latest
    depends_on:
      - secobserve-db
    environment:
      DATABASE_HOST: secobserve-db
      DATABASE_USER: secobserve
      DATABASE_PASSWORD: "secobserve"
      DATABASE_DB: secobserve
    ports:
      - "8081:5000"
    restart: unless-stopped

# Harbor is intentionally NOT here: it ships its own compose via the online
# installer. The runbook covers installing it into {{ stacks_root }}/harbor.
